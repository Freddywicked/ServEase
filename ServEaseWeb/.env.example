# ServEase web app environment variables (Vite).
# Only variables prefixed with VITE_ are exposed to the browser.
# Copy this file to .env for local development, and set the same variable
# in Vercel -> Project Settings -> Environment Variables for production.

# Address of the deployed ServEase backend API.
# Local dev default: http://localhost:5000/api
VITE_API_URL=https://servease-vvgp.onrender.com/api
